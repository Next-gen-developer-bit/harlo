# Harlo Social — production environment template
# Copy this file. Never copy local .env (it has localhost URLs, NOT_SECURED, and a placeholder JWT).
#
# Where to put values
# - Vercel (frontend): URLs, NEXT_PUBLIC_*, IS_GENERAL, STORAGE_PROVIDER, Stripe publishable key.
#   Do NOT add SUPABASE_SERVICE_ROLE_KEY, JWT_SECRET, DATABASE_URL, or OAuth client secrets on Vercel.
# - Backend + orchestrator (Railway / Render / Fly): this whole file.
# - Orchestrator also needs DATABASE_URL, REDIS_URL, TEMPORAL_*, JWT_SECRET, FRONTEND_URL, and email.
#
# Rules
# - HTTPS only. No trailing slashes on URLs.
# - Do not set NOT_SECURED (leave it unset).
# - Generate JWT_SECRET: openssl rand -base64 48
# - Register OAuth redirect URLs on each provider using FRONTEND_URL (see bottom).

NODE_ENV="production"
IS_GENERAL="true"
NX_ADD_PLUGINS=false
DISABLE_REGISTRATION="false"
API_LIMIT=30
FEE_AMOUNT=0.05

# === Public URLs (replace with your real domains)
# Frontend on Vercel, API on a Node host. If you reverse-proxy both on one domain,
# set NEXT_PUBLIC_BACKEND_URL to https://app.your-domain.com/api instead.
FRONTEND_URL="https://app.your-domain.com"
MAIN_URL="https://app.your-domain.com"
NEXT_PUBLIC_BACKEND_URL="https://api.your-domain.com"
BACKEND_INTERNAL_URL="https://api.your-domain.com"

# === Auth
JWT_SECRET=""

# === Database (Postgres) + Redis (required in production)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require&connect_timeout=15"
REDIS_URL="redis://USER:PASSWORD@HOST:6379"

# === Email (required for team invites, password reset, activation)
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
EMAIL_FROM_NAME="Harlo Social"
EMAIL_FROM_ADDRESS="hello@your-domain.com"
# Verify your domain in Resend. beth.t@example.com can only send to your Resend account email.
#
# SMTP instead of Resend:
# EMAIL_PROVIDER="nodemailer"
# EMAIL_HOST="smtp.gmail.com"
# EMAIL_PORT="465"
# EMAIL_SECURE="true"
# EMAIL_USER=""
# EMAIL_PASS=""

# === Storage (Cloudflare R2 is not required)
STORAGE_PROVIDER="supabase"
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="media"
# Backend only for SUPABASE_SERVICE_ROLE_KEY. Never prefix it with NEXT_PUBLIC_.

# Local disk instead of Supabase (single-server only):
# STORAGE_PROVIDER="local"
# UPLOAD_DIRECTORY="/uploads"
# NEXT_PUBLIC_UPLOAD_STATIC_DIRECTORY=""

# Cloudflare R2 later, if you want it:
# STORAGE_PROVIDER="cloudflare"
# CLOUDFLARE_ACCOUNT_ID=""
# CLOUDFLARE_ACCESS_KEY=""
# CLOUDFLARE_SECRET_ACCESS_KEY=""
# CLOUDFLARE_BUCKETNAME=""
# CLOUDFLARE_BUCKET_URL=""
# CLOUDFLARE_REGION="auto"

# === Temporal (required to publish scheduled posts)
# Production: Docker stack in docker-compose.temporal.yaml
#   pnpm run temporal:up
# Same machine as backend/orchestrator:
TEMPORAL_ADDRESS="localhost:7233"
TEMPORAL_NAMESPACE="default"
RUN_CRON="true"
# If backend/orchestrator run in Docker on the harlo-temporal network:
# TEMPORAL_ADDRESS="temporal:7233"
# Temporal Cloud instead of Docker:
# TEMPORAL_ADDRESS="your-namespace.tmprl.cloud:7233"
# TEMPORAL_TLS="true"
# TEMPORAL_API_KEY=""
# Set a strong password when starting Docker Temporal:
# TEMPORAL_DB_PASSWORD=""

# === Stripe (leave empty to run without billing gates)
# Webhook: POST {NEXT_PUBLIC_BACKEND_URL}/stripe
# Events: checkout.session.completed, customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted, invoice.payment_succeeded
STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_SIGNING_KEY=""
STRIPE_SIGNING_KEY_CONNECT=""

# === Social OAuth (backend only for *_SECRET)
# Redirect base is always {FRONTEND_URL}/integrations/social/{provider}
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_MEMBER_POST_ANALYTICS="false"
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
X_CLIENT_ID=""
X_CLIENT_SECRET=""
# X_API_KEY=""
# X_API_SECRET=""
PINTEREST_CLIENT_ID=""
PINTEREST_CLIENT_SECRET=""
THREADS_APP_ID=""
THREADS_APP_SECRET=""
TIKTOK_CLIENT_ID=""
TIKTOK_CLIENT_SECRET=""
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_BOT_TOKEN_ID=""
SLACK_ID=""
SLACK_SECRET=""
SLACK_SIGNING_SECRET=""
TUMBLR_CLIENT_ID=""
TUMBLR_CLIENT_SECRET=""
DRIBBBLE_CLIENT_ID=""
DRIBBBLE_CLIENT_SECRET=""
MASTODON_URL="https://mastodon.social"
MASTODON_CLIENT_ID=""
MASTODON_CLIENT_SECRET=""
BEEHIIVE_API_KEY=""
BEEHIIVE_PUBLICATION_ID=""

# === Optional
OPENAI_API_KEY=""
EXTENSION_ID=""
NEXT_PUBLIC_DISCORD_SUPPORT=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# === OAuth redirect URLs to register (replace FRONTEND_URL)
# YouTube / Google:  {FRONTEND_URL}/integrations/social/youtube
# LinkedIn personal: {FRONTEND_URL}/integrations/social/linkedin
# LinkedIn Page:     {FRONTEND_URL}/integrations/social/linkedin-page
# Facebook:          {FRONTEND_URL}/integrations/social/facebook
# Instagram:         {FRONTEND_URL}/integrations/social/instagram
# X:                 {FRONTEND_URL}/integrations/social/x
# Pinterest:         {FRONTEND_URL}/integrations/social/pinterest
# TikTok:            {FRONTEND_URL}/integrations/social/tiktok
# Threads:           {FRONTEND_URL}/integrations/social/threads
