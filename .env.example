# Configuration reference: http://docs.poscally.com/configuration/reference
# Local development template. For production, copy .env.production.example instead.

# === Required Settings
DATABASE_URL="postgresql://poscally-user:poscally-password@localhost:5432/poscally-db-local"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="random string for your JWT secret, make it long"

# === This needs to be exactly the URL you're accessing Poscally on
FRONTEND_URL="http://localhost:4200"
MAIN_URL="http://localhost:4200"
NEXT_PUBLIC_BACKEND_URL="http://localhost:3000"
BACKEND_INTERNAL_URL="http://localhost:3000"

# === Cloudflare R2 (optional)
# Not needed. Uploads and connected-account avatars go through STORAGE_PROVIDER
# (local or supabase). Uncomment later only if you switch STORAGE_PROVIDER to cloudflare.
# CLOUDFLARE_ACCOUNT_ID="your-account-id"
# CLOUDFLARE_ACCESS_KEY="your-access-key"
# CLOUDFLARE_SECRET_ACCESS_KEY="your-secret-access-key"
# CLOUDFLARE_BUCKETNAME="your-bucket-name"
# CLOUDFLARE_BUCKET_URL="https://your-bucket-url.r2.cloudflarestorage.com/"
# CLOUDFLARE_REGION="auto"

# === Common optional Settings

# Email — required to send team invites, password resets, and activation mail.
# Use Resend (recommended) or SMTP via nodemailer.
# EMAIL_PROVIDER="resend"
# RESEND_API_KEY=""
# EMAIL_FROM_NAME="Harlo Social"
# EMAIL_FROM_ADDRESS="beth.t@example.com"
# For Gmail SMTP instead:
# EMAIL_PROVIDER="nodemailer"
# EMAIL_HOST="smtp.gmail.com"
# EMAIL_PORT="465"
# EMAIL_SECURE="true"
# EMAIL_USER=""
# EMAIL_PASS=""
#DISABLE_REGISTRATION=false

# Where uploaded images and videos are stored: local, cloudflare, or supabase.
# Use supabase (recommended) or local. Skip cloudflare unless you have an R2 bucket.
STORAGE_PROVIDER="local"

# === Supabase Storage (used when STORAGE_PROVIDER=supabase)
# NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-or-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# SUPABASE_STORAGE_BUCKET="media"

# Required only when STORAGE_PROVIDER=local.
#UPLOAD_DIRECTORY=""
#NEXT_PUBLIC_UPLOAD_STATIC_DIRECTORY=""

# Social Media API Settings
X_URL=""
X_CLIENT_ID=""
X_CLIENT_SECRET=""
X_API_KEY=""
X_API_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
# Optional. Set to true only after LinkedIn approves Community Management API
# (r_member_postAnalytics) on this app. Then reconnect personal LinkedIn
# accounts to pull member post impressions. Do not enable before approval —
# LinkedIn will reject the OAuth screen.
LINKEDIN_MEMBER_POST_ANALYTICS="false"
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
BEEHIIVE_API_KEY=""
BEEHIIVE_PUBLICATION_ID=""
LISTMONK_DOMAIN=""
LISTMONK_USER=""
LISTMONK_API_KEY=""
LISTMONK_LIST_ID=""
THREADS_APP_ID=""
THREADS_APP_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
TIKTOK_CLIENT_ID=""
TIKTOK_CLIENT_SECRET=""
PINTEREST_CLIENT_ID=""
PINTEREST_CLIENT_SECRET=""
# Optional. Trial apps create pins on https://api-sandbox.pinterest.com (visible only to the creator).
# Leave unset to use production, with an automatic sandbox retry when Pinterest returns Trial access.
# PINTEREST_API_HOST="https://api-sandbox.pinterest.com"
DRIBBBLE_CLIENT_ID=""
DRIBBBLE_CLIENT_SECRET=""
TUMBLR_CLIENT_ID=""
TUMBLR_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_BOT_TOKEN_ID=""
SLACK_ID=""
SLACK_SECRET=""
SLACK_SIGNING_SECRET=""
MASTODON_URL="https://mastodon.social"
MASTODON_CLIENT_ID=""
MASTODON_CLIENT_SECRET=""

# Chrome Extension Settings (for cookie-based platform integrations like Skool)
EXTENSION_ID=""

# Misc Settings
OPENAI_API_KEY=""
NEXT_PUBLIC_DISCORD_SUPPORT=""
NEXT_PUBLIC_POLOTNO=""
# NOT_SECURED=false
API_LIMIT=30 # The limit of the public API hour limit

# When connecting providers that take a self-hosted URL (WordPress, Mastodon,
# Lemmy, Listmonk, Bluesky PDS, etc.) Poscally fetches that URL server-side and
# blocks requests that resolve to private/internal/loopback/link-local IPs to
# prevent SSRF. Set to true ONLY if your Poscally instance must reach those
# services on a trusted private network (e.g. same Docker network or VPC).
# DISABLE_SSRF_PROTECTION=false

# Payment settings (Stripe Checkout + Billing Portal)
# Use test keys (pk_test_ / sk_test_) until you go live.
# Webhook endpoint to register in Stripe: POST {BACKEND_URL}/stripe
# Events: checkout.session.completed, customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted, invoice.payment_succeeded
FEE_AMOUNT=0.05
STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_SIGNING_KEY=""
STRIPE_SIGNING_KEY_CONNECT=""

# Developer Settings
NX_ADD_PLUGINS=false
IS_GENERAL="true" # required for now

# Temporal (required to publish scheduled posts). The orchestrator worker
# connects here. docker-compose.yaml sets TEMPORAL_ADDRESS=temporal:7233.
TEMPORAL_ADDRESS="localhost:7233"
TEMPORAL_NAMESPACE="default"
# Set to false only if this process must not start the overdue-queue sweep.
RUN_CRON="true"
NEXT_PUBLIC_POSCALLY_OAUTH_DISPLAY_NAME="Authentik"
NEXT_PUBLIC_POSCALLY_OAUTH_LOGO_URL="https://raw.githubusercontent.com/walkxcode/dashboard-icons/master/png/authentik.png"
POSCALLY_GENERIC_OAUTH="false"
POSCALLY_OAUTH_URL="https://auth.example.com"
POSCALLY_OAUTH_AUTH_URL="https://auth.example.com/application/o/authorize"
POSCALLY_OAUTH_TOKEN_URL="https://auth.example.com/application/o/token"
POSCALLY_OAUTH_USERINFO_URL="https://authentik.example.com/application/o/userinfo"
POSCALLY_OAUTH_CLIENT_ID=""
POSCALLY_OAUTH_CLIENT_SECRET=""